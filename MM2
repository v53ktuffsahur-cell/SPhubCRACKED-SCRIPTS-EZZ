local function disablePlayerCollisions(char)
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
end

local function stabPlayersOnce()
    local knife = getKnife()
    if not knife then return end
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local orig = myRoot.CFrame

    local conn = RunService.Stepped:Connect(function() disablePlayerCollisions(char) end)

    local targets = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if r and r.Position.Y < 400 then table.insert(targets, r) end
        end
    end

    if Config.MurdererAutoKillMode == "Teleport to Everyone" then
        for _, r in ipairs(targets) do
            myRoot.CFrame = r.CFrame * CFrame.new(0, 0, 1.2)
            task.wait(0.05)
            pcall(function() knife:Activate() end)
            local ev = knife:FindFirstChild("Events")
            local stab = ev and ev:FindFirstChild("KnifeStabbed")
            if stab then pcall(function() stab:FireServer() end) end
            task.wait(0.05)
        end
    else
        disablePlayerCollisions(char)
        for _, r in ipairs(targets) do
            local model = r.Parent
            if model then r.CFrame = myRoot.CFrame * CFrame.new(0, 0, -2.5) end
        end
        task.wait(0.05)
        pcall(function() knife:Activate() end)
        local ev = knife:FindFirstChild("Events")
        local stab = ev and ev:FindFirstChild("KnifeStabbed")
        if stab then pcall(function() stab:FireServer() end) end
        task.wait(0.1)
    end

    myRoot.CFrame = orig
    if conn then conn:Disconnect() end
end

