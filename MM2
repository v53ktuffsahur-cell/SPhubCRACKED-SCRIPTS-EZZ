local lastCoinTouch = {}
local function collectCoin(folder)
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not folder or not myRoot then return end
    local closest, closestDist
    for _, coin in ipairs(folder:GetChildren()) do
        local last = lastCoinTouch[coin]
        if not last or tick() - last > 2.5 then
            local part = coin:IsA("BasePart") and coin or coin:FindFirstChildWhichIsA("BasePart")
            if part then
                local d = (myRoot.Position - part.Position).Magnitude
                if not closestDist or d < closestDist then
                    closest, closestDist = coin, d
                end
            end
        end
    end
    if not closest then return end
    local part = closest:IsA("BasePart") and closest or closest:FindFirstChildWhichIsA("BasePart")
    if not part then return end
    local conn = RunService.Stepped:Connect(function() disablePlayerCollisions(char) end)
    local dist = (myRoot.Position - part.Position).Magnitude
    if dist > 3 then
        local dur = dist / math.max(Config.CoinFarmSpeed, 1)
        local tw = TweenService:Create(myRoot,
            TweenInfo.new(dur, Enum.EasingStyle.Linear),
            { CFrame = part.CFrame })
        tw:Play()
        local t0 = tick()
        while Config.AutoFarmCoins and tw.PlaybackState == Enum.PlaybackState.Playing
            and tick() - t0 < dur + 1 do
            task.wait(0.02)
        end
    end
    lastCoinTouch[closest] = tick()
    touchOnce(myRoot, part)
    if conn then conn:Disconnect() end
    task.wait(0.02)
end

