local PlayerListCache = { "No Players" }
local function refreshPlayerLists()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(list, p.Name) end
    end
    table.sort(list)
    if #list == 0 then list = { "No Players" } end
    PlayerListCache = list
    if FlingTargetDropdown then FlingTargetDropdown:Refresh(list, true) end
    if TpTargetDropdown   then TpTargetDropdown:Refresh(list, true) end
end
Players.PlayerAdded:Connect(refreshPlayerLists)
Players.PlayerRemoving:Connect(refreshPlayerLists)

