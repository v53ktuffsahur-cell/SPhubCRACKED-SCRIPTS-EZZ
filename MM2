local function drawTracers()
    if not Drawing then return end
    if not Config.TracersEnabled then
        if next(TracerLines) then clearTracers() end
        return
    end
    local vp = workspace.CurrentCamera.ViewportSize
    local from = Vector2.new(vp.X * 0.5, vp.Y)
    for _, plr in ipairs(Players:GetPlayers()) do
        local line = TracerLines[plr]
        if plr == LocalPlayer then
            if line then line:Remove() TracerLines[plr] = nil end
        else
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local role = roleOf(plr)
            local show = root and Config.TracerRoles[role]
            if show then
                if not line then
                    line = Drawing.new("Line")
                    line.Thickness = 1.5
                    line.Transparency = 1
                    TracerLines[plr] = line
                end
                local sp, onScreen = workspace.CurrentCamera:WorldToViewportPoint(root.Position)
                if onScreen then
                    line.From    = from
                    line.To      = Vector2.new(sp.X, sp.Y)
                    line.Color   = RoleColors[role]
                    line.Visible = true
                else
                    line.Visible = false
                end
            elseif line then
                line.Visible = false
            end
        end
    end
end

