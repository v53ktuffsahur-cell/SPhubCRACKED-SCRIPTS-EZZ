local function serverHop()
    local req = request or http_request or (syn and syn.request) or (http and http.request)
    if not req then notify("Server Hop", "No HTTP function available.") return end
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local cursor
    while true do
        local full = url .. (cursor and ("&cursor=" .. cursor) or "")
        local ok, res = pcall(req, { Url = full, Method = "GET" })
        if not (ok and res and res.Body) then
            notify("Server Hop", "Request failed"); return
        end
        local okD, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if not (okD and data and data.data) then
            notify("Server Hop", "Bad response"); return
        end
        for _, srv in ipairs(data.data) do
            if srv.id ~= game.JobId and srv.playing < srv.maxPlayers then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, LocalPlayer)
                return
            end
        end
        cursor = data.nextPageCursor
        if not cursor then notify("Server Hop", "No alternative servers found!"); return end
    end
end

