local function pointCameraAt(part)
    if not part then return end
    local cam = workspace.CurrentCamera
    cam.CFrame = CFrame.new(cam.CFrame.Position, part.Position)
end

local function shootMurderer()
    local char = LocalPlayer.Character
    if not char then return end
    local gun = getGun(LocalPlayer)
    if not gun then
        notify("Error", "You need a Gun!", 2)
        return
    end
    if gun.Parent == LocalPlayer:FindFirstChild("Backpack") then
        gun.Parent = char
        task.wait(0.1)
    end
    local m = findMurderer()
    if not m or not m.Character then
        notify("Error", "Murderer not found or not alive!", 5)
        return
    end
    local mRoot = m.Character:FindFirstChild("HumanoidRootPart")
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not (mRoot and myRoot) then return end

    local origin = mRoot.Position
    if mRoot:IsA("BasePart") and mRoot.AssemblyLinearVelocity.Magnitude > 1.5 then
        origin = origin + mRoot.AssemblyLinearVelocity * 0.08
    end
    local originCF = CFrame.new(origin)

    local shootRemote = gun:FindFirstChild("Shoot")
    if shootRemote and shootRemote:IsA("RemoteEvent") then
        local gunAttach = myRoot:FindFirstChild("GunRaycastAttachment")
        local cf = gunAttach and gunAttach.WorldCFrame or myRoot.CFrame
        shootRemote:FireServer(cf, originCF)
    else
        local saved = workspace.CurrentCamera.CFrame
        pointCameraAt(mRoot)
        task.wait(0.05)
        pcall(function() gun:Activate() end)
        task.wait(0.05)
        workspace.CurrentCamera.CFrame = saved
    end
end

