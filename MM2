local grabbing = false
local function grabGun()
    if grabbing then return end
    if hasTool(LocalPlayer, "Gun") or hasTool(LocalPlayer, "Revolver") then
        notify("Instant Grab Gun", "You already have a Gun/Revolver!", 5)
        return
    end
    local gun = findDroppedGun()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not gun or not gun:IsA("BasePart") or not root then
        notify("Instant Grab Gun", "There no gun dropped", 5)
        return
    end
    grabbing = true
    local orig = root.CFrame
    root.Velocity = Vector3.zero
    root.CFrame = gun.CFrame
    task.wait(0.05)
    touchOnce(root, gun)
    local t0 = tick()
    while tick() - t0 < 0.25 do
        if hasTool(LocalPlayer, "Gun") or hasTool(LocalPlayer, "Revolver") then break end
        task.wait(0.02)
    end
    root.Velocity = Vector3.zero
    root.CFrame = orig
    task.wait(0.5)
    grabbing = false
    if hasTool(LocalPlayer, "Gun") or hasTool(LocalPlayer, "Revolver") then
        notify("Instant Grab Gun", "Gun grabbed successfully!", 3)
    else
        notify("Instant Grab Gun", "Failed to grab gun (someone else might have taken it)!", 5)
    end
end

