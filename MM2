local function previousCleanup()
    if type(env.SPHub_MM2_Cleanup) == "function" then
        pcall(env.SPHub_MM2_Cleanup)
    end
end

local function shutdown()
    for _, fn in ipairs(Cleanups) do pcall(fn) end
    Cleanups = {}
    for k in pairs(Loops) do env[k] = false end
    Loops = {}
    if env.SPHub_FasterKillGui then
        pcall(function() env.SPHub_FasterKillGui:Destroy() end)
        env.SPHub_FasterKillGui = nil
    end
    if env.SPHub_SafePlatform then
        pcall(function() env.SPHub_SafePlatform:Destroy() end)
        env.SPHub_SafePlatform = nil
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "SPHub_GunHighlight" or obj.Name == "SPHub_ESP" or obj.Name == "SPHub_NameTag" then
            pcall(function() obj:Destroy() end)
        end
    end
    if getGlobal("clearTracersGlobally") then
        pcall(getGlobal("clearTracersGlobally"))
    end
    print("[SP Hub] Previous session cleaned up.")
end

