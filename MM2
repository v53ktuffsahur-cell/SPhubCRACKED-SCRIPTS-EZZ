local function flingPlayer(target)
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    local hum   = char and char:FindFirstChildOfClass("Humanoid")
    if not (myRoot and hum and target and target.Character) then return end
    local tr = target.Character:FindFirstChild("HumanoidRootPart")
    if not tr or tr.Position.Y >= 400 then return end
    local orig = myRoot.CFrame
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.new(9e4, 9e4, 9e4)
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Parent = myRoot
    local oldFallen = workspace.FallenPartsDestroyHeight
    pcall(function() workspace.FallenPartsDestroyHeight = -50000 end)
    local t0 = tick()
    while tick() - t0 < 0.5 do
        if not myRoot.Parent or hum.Health <= 0 then break end
        if not tr.Parent or tr.Position.Y >= 400 then break end
        myRoot.CFrame = tr.CFrame
        myRoot.Velocity = Vector3.new(9e4, 9e4, 9e4)
        myRoot.RotVelocity = Vector3.new(0, 9e4, 0)
        RunService.Heartbeat:Wait()
    end
    bv:Destroy()
    pcall(function() workspace.FallenPartsDestroyHeight = oldFallen end)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    myRoot.Velocity = Vector3.zero
    myRoot.CFrame = orig
end

