local function defaultLangName() return "English" end

local function toolIn(container, name)
    return container and container:FindFirstChild(name) or nil
end

local function hasTool(plr, name)
    if not plr then return false end
    local char = plr.Character
    local bp   = plr:FindFirstChild("Backpack")
    return (toolIn(bp, name) or (char and toolIn(char, name))) ~= nil
end

local function getGun(plr)
    if not plr then return nil end
    local char = plr.Character
    local bp   = plr:FindFirstChild("Backpack")
    return (char and (char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")))
        or (bp and (bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver")))
end

local function isMurderer(plr) return hasTool(plr, "Knife") end
local function isSheriff(plr)  return hasTool(plr, "Gun") or hasTool(plr, "Revolver") end

local function roleOf(plr)
    if isMurderer(plr) then return "Murderer" end
    if isSheriff(plr)  then return "Sheriff"  end
    return "Innocent"
end

local function findMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isMurderer(p) then return p end
    end
end

local function findSheriff()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isSheriff(p) then return p end
    end
end

local function touchOnce(a, b)
    if firetouchinterest then
        firetouchinterest(a, b, 0)
        task.wait(0.01)
        firetouchinterest(a, b, 1)
    end
end

local function destroyNameTag(plr)
    local char = plr and plr.Character
    if char then
        local tag = char:FindFirstChild("SPHub_NameTag")
        if tag then tag:Destroy() end
        local hl = char:FindFirstChild("SPHub_ESP")
        if hl then hl:Destroy() end
    end
end

local function refreshESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then
            destroyNameTag(plr)
            continue
        end
        local role = roleOf(plr)
        local selected = Config.RolesESP and Config.ESPRoles[role]

        local hl = char:FindFirstChild("SPHub_ESP")
        if selected then
            if not hl then
                hl = Instance.new("Highlight")
                hl.Name = "SPHub_ESP"
                hl.FillTransparency    = 0.5
                hl.OutlineTransparency = 0
                hl.Adornee = char
                hl.Parent  = char
            end
            hl.FillColor    = RoleColors[role]
            hl.OutlineColor = RoleColors[role]
        elseif hl then
            hl:Destroy()
        end

        local tag = char:FindFirstChild("SPHub_NameTag")
        if Config.NamesESP then
            local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            if not tag and head then
                tag = Instance.new("BillboardGui")
                tag.Name = "SPHub_NameTag"
                tag.Size = UDim2.new(0, 200, 0, 50)
                tag.AlwaysOnTop = true
                tag.ExtentsOffset = Vector3.new(0, 3, 0)
                tag.Adornee = head
                local lbl = Instance.new("TextLabel")
                lbl.Name = "Label"
                lbl.Size = UDim2.new(1, 0, 1, 0)
                lbl.BackgroundTransparency = 1
                lbl.TextStrokeTransparency = 0
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 12
                lbl.Parent = tag
                tag.Parent = char
            end
            if tag then
                local lbl = tag:FindFirstChild("Label")
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local root   = char:FindFirstChild("HumanoidRootPart")
                local dist   = (myRoot and root) and math.floor((myRoot.Position - root.Position).Magnitude) or 0
                local name   = plr.DisplayName or plr.Name
                if lbl then
                    lbl.Text = string.format("%s [%dm]", name, dist)
                    lbl.TextColor3 = RoleColors[role]
                end
                local headNow = char:FindFirstChild("Head") or root
                if headNow then tag.Adornee = headNow end
            end
        elseif tag then
            tag:Destroy()
        end
    end
end

